# ─────────────────────────────────────────────────────────────────────────────
# CivicProof configuration. Copy to .env (gitignored) and fill in.
#   cp .env.example .env && npm run keys -- --write
# Use CIVICPROOF_ENV=/path/to/file to point at a different env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ─────────────────────────────────────────────────────────────────
# testnet   = MST Testnet (chainId 91562037)
# localhost = `npm run node` (Hardhat, chainId 31337) for offline rehearsal
NETWORK=testnet
# Optional overrides for testnet/mainnet (ignored for localhost). Defaults:
#   testnet → https://testnetrpc.mstblockchain.com, 91562037, https://testnet.mstscan.com
# MST_RPC_URL=
# MST_CHAIN_ID=
# MST_EXPLORER_URL=

# ── Keys (NEVER commit) ─────────────────────────────────────────────────────
# Only ADMIN needs testnet MSTC (https://faucet.masterstroke.academy).
# It deploys, configures, funds the ward, pays relayer gas, and can pause.
ADMIN_PRIVATE_KEY=
# Optional separate gas wallet for machine transactions (defaults to ADMIN).
RELAYER_PRIVATE_KEY=
# Signs GuardianApproval. Unfunded.
GUARDIAN_PRIVATE_KEY=
# Machine identities. Unfunded. In DEVICE_SIGNING=device mode these live on
# the ESP32s; here they're used by the simulator / gateway-signing fallback.
BIN_DEVICE_PRIVATE_KEY=
COLLECTOR_DEVICE_PRIVATE_KEY=
# Contractor's receiving wallet (e.g. a BridgeKey address). Show it on MSTScan.
COLLECTOR_PAYOUT_ADDRESS=
# Where unspent ward budget can be withdrawn to (defaults to ADMIN address).
TREASURY_ADDRESS=
# Set only if you deployed without the deploy script.
CONTRACT_ADDRESS=

# ── Registry / policy (applied by `npm run setup:testnet`) ──────────────────
WARD_ID=12
BIN_ID=7
COLLECTOR_ID=1
# UID of the RFID card taped to the collector robot (uppercase hex, no spaces)
COLLECTOR_RFID_UID=A1B2C3D4
# Optional: a second card that triggers the on-chain emergency stop
SUPERVISOR_RFID_UID=
WARD_FUND_MSTC=0.5
BASE_PAYOUT_MSTC=0.01
RATE_PER_POINT_MSTC=0.001
MAX_PAYOUT_MSTC=0.1
DAILY_CAP_MSTC=0.3
SERVICE_WINDOW_SEC=900
MIN_FILL_TO_HIRE=75
MIN_FILL_DELTA=25
MIN_CONFIDENCE=70
# Physical sizes, used for the bin→hopper waste-conservation check
BIN_LITRES=10
HOPPER_LITRES=20

# ── Gateway ─────────────────────────────────────────────────────────────────
PORT=8080
# device  = ESP32s sign with their own keys (the real security story)
# gateway = ESP32s send plain JSON + token, gateway signs (fallback only)
DEVICE_SIGNING=gateway
DEVICE_TOKEN=change-me
AUTO_ACCEPT=true
LOG_INCIDENTS_ONCHAIN=true
CLAIM_WAIT_MS=20000

# ── Guardian extras (off-chain) ─────────────────────────────────────────────
MAX_JOBS_PER_BIN_PER_HOUR=20
MIN_SERVICE_SEC=3
MAX_SERVICE_SEC=600
# hold  = AI down → job waits for a human
# rules = AI down → rules alone may settle payouts ≤ SMALL_PAYOUT_MSTC
AI_FAILURE_MODE=hold
SMALL_PAYOUT_MSTC=0.02

# ── AI verifier (Qwen) ──────────────────────────────────────────────────────
# heuristic = built-in baseline (no model needed)
# openai    = Qwen behind an OpenAI-compatible server (Ollama / vLLM / LM Studio)
# http      = your own Qwen decision service (POST packet → {verdict, confidence})
VERIFIER_MODE=heuristic
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen2.5:7b-instruct
QWEN_API_KEY=
VERIFIER_URL=
VERIFIER_TIMEOUT_MS=20000

# ── Rogue contractor (attack scenarios play as this one) ────────────────────
# `npm run keys -- --write` generates the device key; setup registers it.
ROGUE_COLLECTOR_ID=2
ROGUE_COLLECTOR_RFID_UID=BADC0DE5
ROGUE_COLLECTOR_DEVICE_PRIVATE_KEY=
# defaults to the rogue device address
ROGUE_COLLECTOR_PAYOUT_ADDRESS=
