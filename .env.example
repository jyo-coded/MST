# Copy to .env (never commit .env).
#
# Local rehearsal (no keys needed):   npm run local
# MST Testnet:  set the two lines below, get test MSTC from the MST faucet for
# that key's address, then:  npm run deploy && npm run setup && npm start

NETWORK=testnet
MST_PRIVATE_KEY=0xyour_funded_testnet_key

# ---- optional ---------------------------------------------------------------
# PORT=8080
# PRODUCT_NAME=Astra Waste
# DEFAULT_PAYOUT_MSTC=0.05        # paid per verified collection
# FUND_MSTC=0.5                   # MSTC moved into the ledger by `npm run setup`
# MODE=simulation                 # or live (ESP32 bins)

# Your Qwen model as a second opinion (OpenAI-compatible endpoint, e.g. Ollama)
# AI_PROVIDER=qwen
# QWEN_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_MODEL=qwen2.5:7b-instruct

# Separate keys per role instead of one MST_PRIVATE_KEY (production setup)
# ADMIN_PRIVATE_KEY= / GATEWAY_PRIVATE_KEY= / OFFICER_PRIVATE_KEY= / VERIFIER_PRIVATE_KEY=
# Pay a worker into your own BridgeKey wallet:  WORKER_WALLET_OVERRIDES=WRK-001:0xYourAddress
# Postgres/Supabase instead of the embedded database:  DATABASE_URL=postgres://...
